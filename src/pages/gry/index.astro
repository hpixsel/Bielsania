---
import { getCollection } from "astro:content";
import Game from "../../components/Game.astro";
import Layout from "../../layouts/Layout.astro";
const allGamesPosts = await getCollection("games");
const allGamesPostsSorted = allGamesPosts
  .sort((x: any, y: any) => {
    return x.data.added - y.data.added;
  })
  .reverse();

const gamesPosts = allGamesPostsSorted.map((post) => ({
  title: post.data.title,
  steam: post.data.steam,
  gamejolt: post.data.gamejolt,
  body: post.body,
  img: post.data.imgs[0],
  url: post.slug,
}));
---

<Layout
  title="Nasze Gry"
  description="Zobacz gry tworzone przez Bielsania Entertainment – niezależne studio gier z Bielska-Białej."
>
  <div class="games wrapper">
    <h1 class="games__heading">Nasze <span>Gry</span></h1>
    {
      gamesPosts.map((item) => {
        return (
          <Game
            title={item.title}
            steam={item.steam}
            gamejolt={item.gamejolt}
            body={item.body}
            img={item.img}
            url={item.url}
          />
        );
      })
    }
  </div>
</Layout>

<style>
  .games {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .games__heading {
    font-size: 1.5rem;
    text-align: center;
  }

  .games__heading span {
    color: var(--clr-accent);
  }

  @media (min-width: 60rem) {
    .games__heading {
      font-size: 4rem;
      margin-top: 4rem;
    }
  }
</style>
